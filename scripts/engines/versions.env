# Pinned versions for the engines Morfyl builds and ships.
# Bump a version here and the CI cache key changes, so everything rebuilds.

# Bundled (compiled from source, slim + static)
FFMPEG_VERSION=7.1.1
IMAGEMAGICK_VERSION=7.1.2-32

# Libraries compiled into the bundled engines
ZLIB_VERSION=1.3.1
LIBJPEG_TURBO_VERSION=3.0.4
LIBPNG_VERSION=1.6.44
LIBWEBP_VERSION=1.4.0
LIBTIFF_VERSION=4.6.0
LCMS2_VERSION=2.16
OPENJPEG_VERSION=2.5.2
LIBDE265_VERSION=1.0.15
LIBAOM_VERSION=3.10.0
LIBHEIF_VERSION=1.18.2
LIBXML2_VERSION=2.13.4
LIBRAW_VERSION=0.21.2
LIBJXL_VERSION=0.11.1
LAME_VERSION=3.100
OPUS_VERSION=1.5.2
OGG_VERSION=1.3.5
VORBIS_VERSION=1.3.7
LIBVPX_VERSION=1.14.1
DAV1D_VERSION=1.4.3

# Downloaded-on-demand packs
PANDOC_VERSION=3.6
GHOSTSCRIPT_VERSION=10.04.0
SEVENZIP_VERSION=24.09
