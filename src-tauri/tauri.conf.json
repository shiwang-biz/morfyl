{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morfyl",
  "version": "0.1.0",
  "identifier": "com.craziestcoders.morfyl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Morfyl – File Converter",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Morfyl – File Converter by Craziest Coders",
    "copyright": "© 2026 Craziest Coders",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSES/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Craziest Coders",
    "homepage": "https://craziestcoders.com",
    "longDescription": "Morfyl converts images, video, audio, documents, PDFs, ebooks and archives on your Mac or Windows PC. Made by Craziest Coders – craziestcoders.com"
  }
}
